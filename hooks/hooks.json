{
  "description": "babysitter plugin hooks for Antigravity CLI",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "name": "babysitter-session-start",
            "type": "workflow",
            "command": "adapters-hooks invoke --adapter antigravity --handler \"bash ${ANTIGRAVITY_SKILL_PATH}/hooks/babysitter-proxied-session-start.sh\" --json",
            "timeout": 30000,
            "description": "babysitter SessionStart hook (workflow-driven)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "name": "babysitter-pre-tool-use",
            "type": "workflow",
            "command": "adapters-hooks invoke --adapter antigravity --handler \"bash ${ANTIGRAVITY_SKILL_PATH}/hooks/babysitter-proxied-pre-tool-use.sh\" --json",
